---
# Example Inventory File
# Copy to inventory/prod/hosts.yml or inventory/test/hosts.yml
# Update IP addresses to match your environment

all:
  vars:
    ansible_user: root
    ansible_python_interpreter: /usr/bin/python3
    deploy_env: prod  # or 'test'

  children:
    proxmox:
      hosts:
        pve:
          ansible_host: 192.168.1.100  # Your Proxmox host IP

    containers:
      children:
        monitoring:
          hosts:
            grafana:
              ansible_host: 192.168.1.109  # Update with actual IP
              grafana_port: 3000
            prometheus:
              ansible_host: 192.168.1.115  # Update with actual IP
              prometheus_port: 9090

        network_services:
          hosts:
            adguard:
              ansible_host: 192.168.1.88  # Update with actual IP
              adguard_port: 3000

        smarthome:
          hosts:
            homeassistant:
              ansible_host: 192.168.1.100  # Update with actual IP
              ha_port: 8123

        dashboard:
          hosts:
            homarr:
              ansible_host: 192.168.1.107  # Update with actual IP
              homarr_port: 7575

    # -------------------------------------------------------------------
    # Zabbix distributed monitoring - see docs/zabbix-monitoring.md
    #
    # Hub-and-spoke WireGuard: the server runs ONE interface/port shared by
    # every customer (one [Peer] stanza each, all in the same 10.77.0.0/24
    # tunnel subnet) - onboarding a customer means adding a wg_peers entry
    # and a next-free .N address, NOT a new port or subnet. Each customer's
    # proxy is still a normal single-peer spoke pointed at the server.
    #
    # Real values (IPs, keys, passwords) belong ONLY in prod/hosts.yml,
    # which is gitignored - never fill these in here.
    # -------------------------------------------------------------------
    zabbix_server:
      hosts:
        zabbix-server:
          ansible_host: 192.168.10.50       # tunnel/private IP of the server CT
          ansible_ssh_common_args: '-o ProxyJump=root@100.123.75.57'  # via the OVH host's Tailscale IP
          wg_address: "10.77.0.1/24"
          wg_listen_port: 51830              # the ONLY port ever opened for this, no matter how many customers
          wg_private_key: "CHANGE_ME"        # real inventory only - never commit
          zabbix_db_password: "CHANGE_ME"    # real inventory only - never commit
          zabbix_admin_password: "CHANGE_ME" # real inventory only - never commit
          # One [Peer] entry per customer proxy - keep this in sync with
          # zabbix_customer_proxies below and with each proxy's own
          # wg_address/wg_peer_endpoint entry.
          wg_peers:
            - public_key: "CHANGE_ME"        # zabbix-proxy-local-test's public key
              allowed_ips: "10.77.0.2/32"
          # One entry per customer proxy that should exist on this server:
          zabbix_customer_proxies:
            - name: zabbix-proxy-local-test
              operating_mode: active

    zabbix_proxies:
      hosts:
        zabbix-proxy-local-test:
          ansible_host: 192.168.0.42          # Update with actual IP
          wg_address: "10.77.0.2/24"           # next free .N in the shared 10.77.0.0/24
          wg_peer_public_key: "CHANGE_ME"      # the server's WireGuard public key
          wg_peer_endpoint: "188.165.211.199:51830"
          wg_peer_allowed_ips: "10.77.0.1/32"
          wg_private_key: "CHANGE_ME"          # real inventory only - never commit
          zabbix_proxy_hostname: zabbix-proxy-local-test
          zabbix_proxy_server: "10.77.0.1"

        # One block per additional customer - same port/subnet, next free IP:
        # zabbix-proxy-acme-corp:
        #   ansible_host: <their proxy CT's IP>
        #   wg_address: "10.77.0.3/24"          # next free address, same /24
        #   wg_peer_public_key: "CHANGE_ME"      # the server's public key (same for everyone)
        #   wg_peer_endpoint: "188.165.211.199:51830"  # same port for everyone
        #   wg_peer_allowed_ips: "10.77.0.1/32"
        #   wg_private_key: "CHANGE_ME"
        #   zabbix_proxy_hostname: zabbix-proxy-acme-corp
        #   zabbix_proxy_server: "10.77.0.1"
        #
        # Don't forget to also add this customer's public key to the
        # server's wg_peers list above and to zabbix_customer_proxies.

    # The OVH Proxmox HOST itself (not a container) - owns the one DNAT
    # rule the whole hub-and-spoke tunnel depends on. See
    # roles/ovh_host_networking.
    ovh_proxmox_host:
      hosts:
        ns3079806:
          ansible_host: 100.123.75.57  # reach it over Tailscale, not the public IP

    # The existing reverse-proxy container that already fronts the other
    # *.nordspeed.dk sites - adds one more vhost for the Zabbix frontend.
    # See roles/zabbix_reverse_proxy.
    #
    # Like zabbix_server, this container is on the OVH host's private
    # vmbr1 network - ProxyJump does NOT work here, the host has
    # AllowTcpForwarding disabled as deliberate hardening. Run this play
    # from the OVH host itself instead (ansible_connection: local won't
    # work either, since it targets the CT, not the host - actually SSH
    # to the CT from ON the host, e.g. by running ansible-playbook with
    # this inventory FROM ns3079806, where 192.168.10.105 is directly
    # reachable):
    zabbix_reverse_proxy:
      hosts:
        reverse-proxy:
          ansible_host: 192.168.10.105
